# ==============================================================================
# LIINX Production Environment Configuration
# Copy this file to .env or .env.local and update values accordingly
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Security & Authentication
# Generate a cryptographically secure key: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_characters

# High-Performance Node.js Cluster Mode
# Keep false for one SQLite process. Use true only with a shared edge rate limiter.
CLUSTER=false
# Keep false until a shared limiter, analytics queue, and event store are implemented.
HORIZONTAL_SCALING_ENABLED=false

# Allowed Origins for CORS (comma-separated explicit HTTPS origins)
CORS_ORIGIN=https://YOUR_PUBLIC_DOMAIN.example

# Application Base URL (used in redirects or public references)
APP_ORIGIN=https://YOUR_PUBLIC_DOMAIN.example

# Encrypted integration secrets (generate a separate 32+ character value)
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_OR_32_BYTE_BASE64

# Billing is enabled by default in production. Set false only if launching free-only.
BILLING_ENABLED=true

# Stripe Billing (required for paid plans)
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_LIVE_WEBHOOK_SECRET
STRIPE_PRO_MONTH_PRICE_ID=price_replace_me
STRIPE_PRO_YEAR_PRICE_ID=price_replace_me
STRIPE_STUDIO_MONTH_PRICE_ID=price_replace_me
STRIPE_STUDIO_YEAR_PRICE_ID=price_replace_me

# Durable media storage. Local disk is suitable only for single-node development.
UPLOADS_DIR=./public/uploads
DATABASE_PATH=./data/liinx.db

# ==============================================================================
# Disaster Recovery & Off-Site Backup Configuration
# ==============================================================================
# Storage target: 'local' (default) or 's3' (replicates to S3-compatible remote storage)
BACKUP_STORAGE=local
# Local backup directory for database and uploads snapshots
DATABASE_BACKUP_DIR=./data/backups/db
UPLOAD_BACKUP_DIR=./data/backups/uploads

# Client-Side Backup Encryption (AES-256-GCM)
# If set (or falls back to INTEGRATION_ENCRYPTION_KEY), backups are encrypted prior to remote persistence
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=

# S3-Compatible Remote Backup Storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# S3 Custom Endpoint (e.g., https://<accountid>.r2.cloudflarestorage.com or https://s3.us-west-004.backblazeb2.com)
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=liinx-backups
# Set true for MinIO or path-style S3 gateways
BACKUP_S3_FORCE_PATH_STYLE=false

# Grandfather-Father-Son (GFS) Backup Retention Policy
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# Observability and privacy-safe operations
# Leave Sentry DSNs blank to disable error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=info
ANALYTICS_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=30
MAINTENANCE_ENABLED=true
INSTAGRAM_AUTO_SYNC_ENABLED=true
INSTAGRAM_SYNC_INTERVAL_MINUTES=30
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=support@YOUR_PUBLIC_DOMAIN.example
SUPPORT_INBOX_ADMIN_USER_ID=

# Meta Instagram Graph API & Webhook Configuration (Optional for Auto-Sync)
# Register a Meta App at https://developers.facebook.com
INSTAGRAM_CLIENT_ID=your_meta_app_id
INSTAGRAM_CLIENT_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=https://YOUR_PUBLIC_DOMAIN.example/api/integrations/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_secure_random_verify_token
