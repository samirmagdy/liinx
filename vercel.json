{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/studio",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/account",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/ar/studio",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/ar/account",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://liinx-app.fly.dev/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://liinx-app.fly.dev/uploads/:path*"
    },
    {
      "source": "/r/:path*",
      "destination": "https://liinx-app.fly.dev/r/:path*"
    },
    {
      "source": "/@:username",
      "destination": "https://liinx-app.fly.dev/@:username"
    },
    {
      "source": "/@:username/:pageSlug",
      "destination": "https://liinx-app.fly.dev/@:username/:pageSlug"
    },
    {
      "source": "/demo/:identifier",
      "destination": "https://liinx-app.fly.dev/demo/:identifier"
    },
    {
      "source": "/robots.txt",
      "destination": "https://liinx-app.fly.dev/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://liinx-app.fly.dev/sitemap.xml"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/ar/studio",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/ar/account",
      "destination": "/index.html"
    }
  ]
}
