# ==============================================================================
# LIINX Production Environment Configuration
# Copy this file to .env or .env.local and update values accordingly
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Security & Authentication
# Generate a cryptographically secure key: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_characters

# High-Performance Node.js Cluster Mode
# Set to 'true' to spawn a worker process per CPU core for massive concurrency
CLUSTER=false

# Allowed Origins for CORS (Comma-separated, or * for public APIs)
CORS_ORIGIN=*

# Application Base URL (used in redirects or public references)
APP_URL=http://localhost:3000

# Meta Instagram Graph API & Webhook Configuration (Optional for Auto-Sync)
# Register a Meta App at https://developers.facebook.com
INSTAGRAM_CLIENT_ID=your_meta_app_id
INSTAGRAM_CLIENT_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_secure_random_verify_token

