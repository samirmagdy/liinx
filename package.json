{
  "name": "liinx-design-first-link-in-bio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "build": "vite build && tsx scripts/prerender.tsx",
    "start": "NODE_ENV=production tsx server/server.ts",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "vitest run tests/backend-e2e.dynamic.test.ts --no-file-parallelism",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:backup": "tsx scripts/backup-db.ts",
    "uploads:backup": "tsx scripts/backup-uploads.ts",
    "backup:verify": "tsx scripts/verify-restore.ts",
    "health:check": "node scripts/check-health.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sentry/node": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/vite": "^4.1.14",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.6.2",
    "tsx": "^4.21.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
